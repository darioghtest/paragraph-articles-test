---
/**
 * Shared <head> contents: title, description, canonical, Open Graph and
 * Twitter cards, article times, JSON-LD, and alternates.
 */
import { absoluteUrl, withBase } from "@/lib/articles"
import { type Breadcrumb, breadcrumbJsonLd } from "@/lib/siteJsonLd"

export interface AlternateLink {
  type: string
  href: string
  title?: string
}

export interface ArticleMeta {
  publishedTime: Date
  modifiedTime: Date
  authors: string[]
}

interface Props {
  title: string
  socialTitle?: string
  description: string
  /** Site path, without the base. */
  canonical: string
  /** Site path of the image, without the base. */
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
  jsonLd?: unknown
  breadcrumbs?: Breadcrumb[]
  type?: "website" | "article"
  alternates?: AlternateLink[]
  article?: ArticleMeta
  robots?: string
}

const {
  title,
  socialTitle = title,
  description,
  canonical,
  image = "/images/og-default.png",
  imageAlt,
  imageWidth,
  imageHeight,
  jsonLd,
  breadcrumbs,
  type = "website",
  alternates = [],
  article,
  robots = "index, follow",
} = Astro.props

const site = Astro.site
const pageUrl = absoluteUrl(canonical, site)
const imageUrl = absoluteUrl(image, site)
const jsonLdScript = (data: unknown) =>
  JSON.stringify(data).replace(/</g, "\\u003c")
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={pageUrl} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={socialTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={pageUrl} />
<meta property="og:image" content={imageUrl} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{
  imageHeight && (
    <meta property="og:image:height" content={String(imageHeight)} />
  )
}
<meta property="og:site_name" content="Lumen" />
{
  article && (
    <>
      <meta
        property="article:published_time"
        content={article.publishedTime.toISOString()}
      />
      <meta
        property="article:modified_time"
        content={article.modifiedTime.toISOString()}
      />
      {article.authors.map((name) => (
        <meta property="article:author" content={name} />
      ))}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={socialTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:site" content="@lumendocs" />
{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={jsonLdScript(jsonLd)}
    />
  )
}
{
  breadcrumbs && breadcrumbs.length > 0 && (
    <script
      is:inline
      type="application/ld+json"
      set:html={jsonLdScript(breadcrumbJsonLd(breadcrumbs, site))}
    />
  )
}
{
  alternates.map((alternate) => (
    <link
      rel="alternate"
      type={alternate.type}
      href={absoluteUrl(alternate.href, site)}
      title={alternate.title}
    />
  ))
}
<link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
